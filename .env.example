# Clerk - from dashboard.clerk.com -> Configure -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends people for sign-in and where it lands them afterward
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Upstash Redis - same credentials used in portal-sync/.env
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic - for the Assistant chatbot. Get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# Outbound email (new-order notification to the order desk). Pick one provider.
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM="Hayward Portal <orders@portal-hayward.com>"
#   -- or --
# MAIL_PROVIDER=graph
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# MAIL_FROM=au-orders@hayward.com
ORDER_NOTIFY_TO=au-orders@hayward.com
NEXT_PUBLIC_PORTAL_URL=https://portal-hayward.com
